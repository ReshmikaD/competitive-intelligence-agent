# --- Required: powers the real "Run Your Own Analysis" workflow ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for report generation.
# Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Required: powers "Email this report" ---
# Your Gmail address, and a 16-character Google App Password (not your normal password).
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Optional: enables monthly delivery, login, and the /account report feed ---
# Without these, monthly subscriptions silently aren't persisted, login is
# disabled with a clear error, and the monthly cron route no-ops safely --
# the core "generate a report, email it once" flow still works fully
# without any of this.
# Add the free Upstash Redis integration from the Vercel Marketplace/Storage
# tab, or create your own at https://upstash.com, then paste the REST
# credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required alongside Upstash for login/the /account feed: signs session
# cookies. Generate one with: openssl rand -hex 32
# (Not needed if you don't want login -- the rest of the app works without it.)
SESSION_SECRET=

# Optional: shared secret Vercel Cron sends as a Bearer token, so the
# /api/cron/monthly-report route only accepts requests from your own cron job.
CRON_SECRET=

# Optional: protects /api/debug/email-check, a one-off route that verifies
# your Gmail SMTP credentials without sending a real email. Pick any random
# string. Without this set, the route stays disabled.
DEBUG_EMAIL_SECRET=
