# --- Required: powers the real "Run Your Own Analysis" workflow ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for report generation.
# Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: enables login and the /account report feed ---
# Without these, login is disabled with a clear error — the core
# "generate a report" flow still works fully without any of this.
# Add the free Upstash Redis integration from the Vercel Marketplace/Storage
# tab, or create your own at https://upstash.com, then paste the REST
# credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required alongside Upstash for login/the /account feed: signs session
# cookies. Generate one with: openssl rand -hex 32
# (Not needed if you don't want login — the rest of the app works without it.)
SESSION_SECRET=
